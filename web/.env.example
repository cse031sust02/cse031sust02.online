# Copy to .env (Docker) or .env.local (npm run dev) and fill in. Never commit the real file.
# Everything except NEXT_PUBLIC_* is server-only.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL: canonical links, sitemap, OG image, OpenRouter attribution.
# NEXT_PUBLIC_* values are inlined at BUILD time (Docker: pass as build args, see docker-compose.yml).
NEXT_PUBLIC_SITE_URL=https://cse031sust02.online

# ── Digital Twin (OpenRouter) ────────────────────────────────────────────────
# Without a key, the site works and the twin shows "twin offline".
OPENROUTER_API_KEY=sk-or-...
# Optional: OpenRouter model id, or a comma-separated fallback list.
# Default: nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free,openrouter/free
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Contact form (SMTP via nodemailer) ───────────────────────────────────────
# Without SMTP_HOST / CONTACT_TO_EMAIL the form shows "contact temporarily unavailable".
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be allowed by your SMTP provider). Defaults to SMTP_USER.
SMTP_FROM=
# Where contact messages are delivered. Never shown on the site.
CONTACT_TO_EMAIL=

# ── Optional: Cloudflare Turnstile (spam protection) ─────────────────────────
# When TURNSTILE_SECRET_KEY is set, the contact form requires a valid token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
